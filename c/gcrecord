#include "gcrecord.h"

/* A font is a handle which holds what it was asked for */
struct font_s {
    char    name[GCR_TEXT_MAX + 1];
    int32_t xsize, ysize;
    int     live;
};

typedef struct recorder_s {
    gcrecord_t *records;
    int         count;
    int         capacity;
    int32_t     char_width, ascent, descent;
    struct font_s **fonts;                /* Every font made, to free them */
    int         font_count;
    int         font_capacity;
} recorder_t;

static recorder_t *recorder_of(const gcontext_t *gc)
{
    return (recorder_t *)gc->backend_private;
}

/* Add a record, filled with the clip as it is now; NULL if memory ran out */
static gcrecord_t *add(gcontext_t *gc, gcrecord_kind_t kind)
{
    recorder_t *r = recorder_of(gc);
    gcrecord_t *rec;

    if (r->count == r->capacity)
    {
        int capacity = r->capacity ? r->capacity * 2 : 64;
        gcrecord_t *bigger = (gcrecord_t *)realloc(r->records,
                                                   (size_t)capacity * sizeof(gcrecord_t));

        if (bigger == NULL)
        {
            return NULL;
        }
        r->records = bigger;
        r->capacity = capacity;
    }
    rec = &r->records[r->count++];
    memset(rec, 0, sizeof(*rec));
    rec->kind = kind;
    rec->has_clip = (gc->clipstate == cs_clip);
    rec->clip = gc->clipping;
    return rec;
}

static void copy_text(gcrecord_t *rec, const char *text, int size)
{
    size_t n;

    if (text == NULL)
    {
        return;
    }
    n = (size == GCONTEXT_ZEROTERM) ? strlen(text) : (size_t)size;
    if (n > GCR_TEXT_MAX)
    {
        n = GCR_TEXT_MAX;
    }
    memcpy(rec->text, text, n);
    rec->text[n] = '\0';
}

/* The length of a string in characters, as it was given */
static size_t string_length(const char *text, int size)
{
    return (size == GCONTEXT_ZEROTERM) ? strlen(text) : (size_t)size;
}

