                    int32_t x0, int32_t y0, int32_t x1, int32_t y1)
{
    gcrecord_t *rec = add(gc, kind);

    if (rec) { rec->x0 = x0; rec->y0 = y0; rec->x1 = x1; rec->y1 = y1; }
}

