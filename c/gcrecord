static void op_rectangle_fill(gcontext_t *gc, colour_t colour,
                              int x0, int y0, int x1, int y1)
{
    gcrecord_t *rec = add(gc, GCR_RECTANGLE_FILL);

    if (rec) { rec->colour = colour; rec->x0 = x0; rec->y0 = y0; rec->x1 = x1; rec->y1 = y1; }
}

static void op_rectangle_outline(gcontext_t *gc, colour_t colour,
                                 int32_t x0, int32_t y0, int32_t x1, int32_t y1)
{
    gcrecord_t *rec = add(gc, GCR_RECTANGLE_OUTLINE);

    if (rec) { rec->colour = colour; rec->x0 = x0; rec->y0 = y0; rec->x1 = x1; rec->y1 = y1; }
}

static void op_triangle_fill(gcontext_t *gc, colour_t colour, int32_t x0, int32_t y0,
                             int32_t x1, int32_t y1, int32_t x2, int32_t y2)
{
    gcrecord_t *rec = add(gc, GCR_TRIANGLE_FILL);

    if (rec)
    {
        rec->colour = colour;
        rec->x0 = x0; rec->y0 = y0; rec->x1 = x1; rec->y1 = y1;
        rec->x2 = x2; rec->y2 = y2;
    }
}

static void op_line_start(gcontext_t *gc, colour_t colour)
{
    gcrecord_t *rec = add(gc, GCR_LINE_START);

    if (rec) { rec->colour = colour; }
}

