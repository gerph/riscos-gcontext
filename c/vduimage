 * File:     vduimage
 * Purpose:  Image plotting via the ImageFileRender module, and
 *           sprite tiling via OS_SpriteOp, for the VDU backend
 * Author:   Gerph
 * Date:     04 Sep 2026
 ******************************************************************/

#include <stdint.h>
#include <stdlib.h>
#include <stdio.h>
#include "swis.h"

#include "gcontext.h"
#include "screen.h"
#include "vduimage.h"

/* ImageFileRender isn't in the standard swis.h, so its SWI number is
   defined locally - see
   https://gerph.github.io/riscos-prminxml-staging/prm-ro2/html/select/graphics/imagefilerender.html
   for the register interface this file implements against. */
#define ImageFileRender_Render 0x562c0

/* ImageFileRender_Render's R0 rendering-flags bits used here: a plain
   "size" transform (bits 0-2 = 0, stretch to the given width/height)
   plus bit 5 requesting OS-unit coordinates throughout, matching
   this GContext's own coordinate system so no Draw-unit (1/256 OS
   unit) conversion is needed. */
#define IFR_TRANSFORMTYPE_SIZE   (0)
#define IFR_FLAG_RETURN_OSUNITS  (1 << 5)

/* R8's block for a "size" transform: stretch the image to exactly
   this width/height, in OS units per IFR_FLAG_RETURN_OSUNITS above. */
typedef struct {
    int32_t width;
    int32_t height;
    int32_t border;
    int32_t angle;
} ifr_fitblock_t;

/*************************************************** Gerph *********
 Function:     image_plot
 Description:  Renders in-memory image data into a box, via
               ImageFileRender_Render
 Parameters:   filetype = RISC OS filetype data is
               data, length = image data
               x0,y0,x1,y1 = box to plot into
 Returns:      true if plotted, false if declined or failed
 ******************************************************************/
static bool image_plot(gcontext_filetype_t filetype, const void *data, size_t length,
                       int32_t x0, int32_t y0, int32_t x1, int32_t y1)
{
    ifr_fitblock_t fit;
    _kernel_oserror *err;
    fit.width = x1 - x0;
    fit.height = y1 - y0;
    fit.border = 0;
    fit.angle = 0;
    err = _swix(ImageFileRender_Render, _INR(0, 8),
               IFR_TRANSFORMTYPE_SIZE | IFR_FLAG_RETURN_OSUNITS,
               filetype, data, length, 0, 0, x0, y0, &fit);
    return err == NULL;
}

/*************************************************** Gerph *********
 Function:     gcontext_vdu_image_plot_data
 Description:  Plot an in-memory image into a box, via ImageFileRender
 Parameters:   gc-> graphics context, unused
               filetype = RISC OS filetype data is
               data, length = image data
               x0,y0,x1,y1 = box to plot into
 Returns:      true if plotted, false if declined or failed
 ******************************************************************/
bool gcontext_vdu_image_plot_data(gcontext_t *gc, gcontext_filetype_t filetype,
                                  const void *data, size_t length,
                                  int32_t x0, int32_t y0, int32_t x1, int32_t y1)
{
    (void) gc;
    if (data == NULL || length == 0)
        return false;
    return image_plot(filetype, data, length, x0, y0, x1, y1);
}

/*************************************************** Gerph *********
 Function:     gcontext_vdu_image_plot_file
 Description:  Plot an image file into a box, via ImageFileRender.
               ImageFileRender_Render only takes in-memory data, so
               the whole file is read into memory first.
 Parameters:   gc-> graphics context, unused
               filetype = RISC OS filetype filename is
               filename = image file to render
               x0,y0,x1,y1 = box to plot into
 Returns:      true if plotted, false if the file couldn't be read,
               or the renderer declined or failed
 ******************************************************************/
bool gcontext_vdu_image_plot_file(gcontext_t *gc, gcontext_filetype_t filetype,
                                  const char *filename,
                                  int32_t x0, int32_t y0, int32_t x1, int32_t y1)
{
    FILE *fh;
    long size;
    void *buffer;
    bool ok;
    (void) gc;
    if (filename == NULL)
        return false;
    fh = fopen(filename, "rb");
    if (fh == NULL)
        return false;
    if (fseek(fh, 0, SEEK_END) != 0 || (size = ftell(fh)) < 0 || fseek(fh, 0, SEEK_SET) != 0)
    {
        fclose(fh);
        return false;
    }
    buffer = malloc((size_t) size);
    if (buffer == NULL && size != 0)
    {
        fclose(fh);
        return false;
    }
    if (size > 0 && fread(buffer, 1, (size_t) size, fh) != (size_t) size)
    {
        fclose(fh);
        free(buffer);
        return false;
    }
    fclose(fh);
    ok = image_plot(filetype, buffer, (size_t) size, x0, y0, x1, y1);
    free(buffer);
    return ok;
}

/*************************************************** Gerph *********
 Function:     build_sprite_translation_table
 Description:  Builds a pixel translation table (ColourTrans_SelectTable)
               mapping the sprite's own palette to the current screen
               mode/palette, for passing to a scaled sprite plot -
               without one, a sprite whose palette differs from the
               current mode's (eg an old-format 4bpp sprite defined in
               a different mode) is plotted using its raw pixel values
               as if they were already the destination's colour
               numbers, producing wrong colours.
 Parameters:   area = sprite area, or GCONTEXT_NO_SPRITE_AREA
               name_or_sprite_pointer = sprite name within area, or a
                                        direct sprite pointer if area
                                        is GCONTEXT_NO_SPRITE_AREA
 Returns:      Malloc'd table (caller frees), or NULL if one couldn't
               be built - callers should fall back to no translation
               (R7 = 0) rather than failing the whole plot.
 ******************************************************************/
static void *build_sprite_translation_table(void *area, const void *name_or_sprite_pointer)
{
    _kernel_oserror *err;
    int32_t source;
    int32_t flags;
    int32_t buffer_size;
    void *buffer;
    if (area != GCONTEXT_NO_SPRITE_AREA)
    {
        /* R0 = real area pointer, R1 = sprite name pointer (bit 0 of
           R5 clear). */
        source = (int32_t) area;
        flags = 0;
    }
    else
    {
        /* R0 = 256 means "not a sprite area pointer - R1 points
           directly to a sprite" (bit 0 of R5 set to match). */
        source = 256;
        flags = 1;
    }
    err = _swix(ColourTrans_SelectTable, _INR(0, 5) | _OUT(4), source, name_or_sprite_pointer,
               -1, -1, 0, flags, &buffer_size);
    if (err != NULL || buffer_size <= 0)
        return NULL;
    buffer = malloc((size_t) buffer_size);
    if (buffer == NULL)
        return NULL;
    err = _swix(ColourTrans_SelectTable, _INR(0, 5), source, name_or_sprite_pointer, -1, -1,
               buffer, flags);
    if (err != NULL)
    {
        free(buffer);
        return NULL;
    }
    return buffer;
}

/*************************************************** Gerph *********
 Function:     gcontext_vdu_tile_fill
 Description:  Tile a sprite to fill a box, via OS_SpriteOp 65 (Tile
               Sprite Scaled, SpriteExtend 1.73+) - a genuine native
               tiling primitive, not something built out of repeated
               single plots. The graphics window is narrowed to the
               box first, since OS_SpriteOp 65 tiles across whatever
               the current graphics window is, with the origin free
               to fall inside or outside it. Never addresses the
               system sprite area (applications must not use it) -
               area is either a caller-owned sprite area (name
               lookup within it) or GCONTEXT_NO_SPRITE_AREA (a direct
               sprite pointer, needing no area to locate it).
 Parameters:   gc-> graphics context, unused
               filetype = must be GCONTEXT_FILETYPE_SPRITE
               area = caller-owned sprite area, or GCONTEXT_NO_SPRITE_AREA
               name_or_sprite_pointer = sprite name within area, or a
                                        direct sprite pointer if area
                                        is GCONTEXT_NO_SPRITE_AREA
               x0,y0,x1,y1 = box to fill
 Returns:      true if tiled, false if filetype isn't a sprite, or
               the sprite couldn't be found/plotted
 ******************************************************************/
bool gcontext_vdu_tile_fill(gcontext_t *gc, gcontext_filetype_t filetype,
                            void *area, const void *name_or_sprite_pointer,
                            int32_t x0, int32_t y0, int32_t x1, int32_t y1)
{
    _kernel_oserror *err;
    bbox_t saved_window;
    bbox_t tile_window;
    int32_t reason;
    void *translation_table;
    bool ok;
    (void) gc;
    if (filetype != GCONTEXT_FILETYPE_SPRITE || name_or_sprite_pointer == NULL)
        return false;
    if (screen_get_graphics_window(&saved_window) != 0)
        return false;
    tile_window.x0 = x0;
    tile_window.y0 = y0;
    tile_window.x1 = x1;
    tile_window.y1 = y1;
    if (screen_set_graphics_window(&tile_window) != 0)
        return false;
    /* Without a translation table, the sprite's raw pixel values are
       used as destination colour numbers directly, which is wrong
       whenever the sprite's own palette differs from the current
       mode's - see build_sprite_translation_table(). A NULL result
       (table couldn't be built) falls back to no translation rather
       than failing the plot outright. */
    translation_table = build_sprite_translation_table(area, name_or_sprite_pointer);
    /* area given: +256, R1=area, R2=name. No area: +512, R1 unused (a
       sprite pointer is self-locating), R2=sprite pointer. Either way,
       R3,R4=origin, R5=plot action (0=overwrite), R6=scale factors
       (0=1:1), R7=pixel translation table. */
    reason = area != GCONTEXT_NO_SPRITE_AREA ? 65 + 256 : 65 + 512;
    err = _swix(OS_SpriteOp, _INR(0, 7), reason, area, name_or_sprite_pointer, x0, y0, 0, 0,
               translation_table);
    ok = (err == NULL);
    free(translation_table);
    screen_set_graphics_window(&saved_window);
    return ok;
}
